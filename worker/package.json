{
  "name": "awebchatbot-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AWebChatbot - AI chatbot, live chat and shared inbox on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "dev:offline": "node scripts/offline-config.mjs && wrangler d1 migrations apply awebchatbot --local -c .wrangler-offline.toml && wrangler dev -c .wrangler-offline.toml",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply awebchatbot --local",
    "db:migrate": "wrangler d1 migrations apply awebchatbot --remote",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents@2.3.3": true
  }
}
